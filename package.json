{
  "name": "hataroo",
  "version": "0.1.0",
  "description": "A terminal UI for managing a folder of git repositories at once: bulk status, ff-only pull, and dependency install.",
  "license": "MIT",
  "bin": {
    "hataroo": "dist/hataroo-cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
